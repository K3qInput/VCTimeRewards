modules = ["java-graalvm22.3"]

[nix]
channel = "stable-25_05"
packages = ["maven"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Maven Build"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "maven_build"

[[workflows.workflow]]
name = "Maven Build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mvn clean package -DskipTests"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "maven_build"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mvn clean compile"

[agent]
expertMode = true

[deployment]
deploymentTarget = "autoscale"
run = ["echo", "VCTimeRewards plugin JAR built successfully. This is a Minecraft plugin that should be deployed to a Minecraft server's plugins folder."]
build = ["mvn", "clean", "package", "-DskipTests"]
