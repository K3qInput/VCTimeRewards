modules = ["java-graalvm22.3"]

[nix]
channel = "stable-25_05"
packages = ["maven"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Build Plugin"

[[workflows.workflow]]
name = "Build Plugin"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "mvn clean package -DskipTests"

[workflows.workflow.metadata]
outputType = "console"

[agent]
expertMode = true

[deployment]
deploymentTarget = "autoscale"
run = ["echo", "VCTimeRewards plugin built successfully. Download the JAR from target/VCTimeRewards-1.0.0.jar and install it on your Minecraft server."]
build = ["mvn", "clean", "package", "-DskipTests"]
